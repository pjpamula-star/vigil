<Window x:Class="Vigil.UI.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vigil.UI"
        Title="Vigil" Width="348" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text1}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
    <!-- A wash of the state's color behind the header: blue working, amber needs you, green done. -->
    <Border x:Name="Wash" Height="170" VerticalAlignment="Top" IsHitTestVisible="False"/>
    <StackPanel Margin="20,18,20,16">

        <!-- 1. One word for the state, one sentence for why. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="EyeTile" Width="44" Height="44" CornerRadius="12" Background="{StaticResource Card}" VerticalAlignment="Top">
                <ui:EyeView x:Name="Eye" Width="28" Height="28"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="StateTitle" Style="{StaticResource TitleXL}" FontSize="22" LineHeight="26" Text="Awake"/>
                <TextBlock x:Name="StateLine" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" Text="Claude is working. Safe to close the lid."/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,-4,-8,0" ToolTip="Settings" Click="OnSettings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Text3}"/>
            </Button>
        </Grid>

        <!-- Countdown, only for "keep awake for…" -->
        <TextBlock x:Name="Countdown" Typography.NumeralAlignment="Tabular" Visibility="Collapsed" Margin="58,8,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>

        <!-- Not connected yet -->
        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Margin="58,12,0,0" HorizontalAlignment="Left" Content="Connect to Claude Code" Click="OnConnect" Visibility="Collapsed"/>

        <!-- 2. Each Claude session: name, then what it's doing in plain words. -->
        <ItemsControl x:Name="Sessions" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:SessionVM}">
                    <Border x:Name="Row" Padding="10,9" CornerRadius="12" Background="Transparent" Cursor="Hand" Margin="-10,0"
                            MouseLeftButtonUp="OnSessionClick" Tag="{Binding Id}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding Avatar}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="13.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,1,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,1,0,0">
                                <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Meta}" Typography.NumeralAlignment="Tabular" Style="{StaticResource Caption}" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Card}"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,12,0,12"/>

        <!-- 3. One action. -->
        <Grid MinHeight="30">
            <!-- Holding: hold × to end -->
            <ui:RingHold x:Name="EndHold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- Not holding: type a number, press Enter (Insomnia's gesture) -->
            <StackPanel x:Name="KeepAwakeRow" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock x:Name="KeepAwakeLabel" Text="Keep awake for" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center"/>
                <TextBox x:Name="HoursBox" Style="{StaticResource Field}" Width="44" Margin="8,0,6,0" Padding="8,4" TextAlignment="Center"
                         KeyDown="OnHoursKey" ToolTip="Type hours (2), minutes (30m) or h:mm (1:30), then press Enter"/>
                <TextBlock Text="hours" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Paused -->
            <Button x:Name="ResumeLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnResume" Visibility="Collapsed">
                <TextBlock Text="Turn back on" Foreground="{StaticResource Blue}" FontSize="12.5"/>
            </Button>

            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnHappened">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="What happened" Foreground="{StaticResource Blue}" FontSize="12.5"/>
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{StaticResource Blue}" VerticalAlignment="Center" Margin="5,1,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Facts, quietly: Insomnia's "Lid: open · 87%" -->
        <TextBlock x:Name="Facts" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,12,0,0"/>
    </StackPanel>
    </Grid>
</Window>
